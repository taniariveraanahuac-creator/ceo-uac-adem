{
  "rules": {
    ".read": false,
    ".write": false,
    "ceoleon": {
      "live": {
        ".read": true,
        ".write": true,
        ".validate": "newData.hasChildren(['j']) && newData.child('j').isString() && newData.child('j').val().length < 200"
      },
      "games": {
        "$code": {
          ".read": true,
          ".write": true,
          ".validate": "$code.matches(/^[A-Z0-9]{4}$/) && newData.hasChildren(['j']) && newData.child('j').isString() && newData.child('j').val().length < 100000"
        }
      },
      "rooms": {
        "$code": {
          "peers": {
            ".read": true,
            "$id": {
              ".write": true,
              ".validate": "newData.hasChildren(['p']) && newData.child('p').isString() && newData.child('p').val().length < 2000"
            }
          }
        }
      }
    }
  }
}
